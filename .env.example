# SortPi Environment Configuration Example
# All values must remain empty or contain non-sensitive sample placeholders. Never commit real credentials.

# Upstream Webhook URL for demo inquiries and contact submissions
# In development, leave blank to enable local server preview mode.
# In production, provide an authorized webhook destination (e.g. CRM, Slack, or webhook endpoint).
DEMO_WEBHOOK_URL=""

# Optional Webhook Signature Secret (for HMAC verification with upstream CRM)
DEMO_WEBHOOK_SECRET=""

# Optional Analytics Tracking Identifier (e.g. G-XXXXXXXXXX)
# When left unset, the internal analytics adapter operates as a zero-overhead safe no-op.
NEXT_PUBLIC_ANALYTICS_ID=""

# Base Canonical URL
NEXT_PUBLIC_SITE_URL="https://www.sortpi.com"

# Preview Mode Flag (Set to "true" for staging/preview deployments to enable noindex)
NEXT_PUBLIC_PREVIEW_MODE="false"
